        <mxCell id="e8" edge="1" parent="1" source="services" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0f766e;fontColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;" target="files" value="guardar/servir archivos">
          <mxGeometry relative="1" as="geometry" />
