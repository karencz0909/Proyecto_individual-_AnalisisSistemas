        <mxCell id="e7" edge="1" parent="1" source="repos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0f766e;fontColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;" target="db" value="EF Core">
