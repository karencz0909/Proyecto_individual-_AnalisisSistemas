        <mxCell id="db" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#34d399;fontColor=#243247;fontSize=13;align=left;verticalAlign=top;spacing=13;" value="&lt;b&gt;SQL Server · BecaNetDB&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Identidad (TPT)&lt;/b&gt;&lt;br&gt;Usuario → Estudiante / CoordinadorBecas / EvaluadorComite&lt;br&gt;&lt;br&gt;&lt;b&gt;Proceso de beca&lt;/b&gt;&lt;br&gt;Convocatorias → Solicitudes&lt;br&gt;Documentos · Comites · ComiteMiembros&lt;br&gt;Evaluaciones · AprobacionSolicitud&lt;br&gt;&lt;br&gt;&lt;b&gt;Trazabilidad&lt;/b&gt;&lt;br&gt;RegistroAuditoria · NotificacionSolicitud&lt;br&gt;&lt;br&gt;Claves foráneas, índices únicos y restricción del tipo de aprobación. El esquema se prepara con BecaNet_Nuevos_Requisitos.sql al iniciar la API." vertex="1">
          <mxGeometry height="430" width="350" x="1380" y="215" as="geometry" />
        </mxCell>
