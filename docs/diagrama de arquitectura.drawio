        <mxCell id="e6" edge="1" parent="1" source="services" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7c3aed;fontColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;" target="repos" value="consultas y reglas">
