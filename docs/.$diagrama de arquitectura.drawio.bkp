<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-10-29T18:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="becanet-architecture" name="Arquitectura BecaNet">
    <mxGraphModel dx="1920" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="BecaNet | Arquitectura de la solución" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#152b4a;strokeColor=#152b4a;fontColor=#ffffff;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="30" y="25" width="1850" height="76" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Vista lógica de los componentes, responsabilidades, seguridad y flujo de postulaciones" style="text;html=1;align=left;verticalAlign=middle;fontColor=#52647a;fontSize=14;" vertex="1" parent="1"><mxGeometry x="36" y="105" width="1500" height="30" as="geometry"/></mxCell>

        <mxCell id="actorshead" value="PERSONAS Y ROLES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f1ff;strokeColor=#a8c4f5;fontColor=#1d4ed8;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="220" height="46" as="geometry"/></mxCell>
        <mxCell id="student" value="&lt;b&gt;Estudiante&lt;/b&gt;&lt;br&gt;• Registro e inicio de sesión&lt;br&gt;• Consulta convocatorias&lt;br&gt;• Envía solicitud y documentos&lt;br&gt;• Sigue estado y notificaciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;fontColor=#243247;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="215" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="coordinator" value="&lt;b&gt;Coordinador&lt;/b&gt;&lt;br&gt;• Convocatorias y comités&lt;br&gt;• Asigna/distribuye solicitudes&lt;br&gt;• Gestiona perfiles&lt;br&gt;• Decide solicitudes y consulta auditoría" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;fontColor=#243247;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="385" width="220" height="165" as="geometry"/></mxCell>
        <mxCell id="evaluator" value="&lt;b&gt;Evaluador&lt;/b&gt;&lt;br&gt;• Ve solicitudes asignadas&lt;br&gt;• Revisa documentos y motivo&lt;br&gt;• Registra puntaje y observaciones&lt;br&gt;• Mueve a «Revisado»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontColor=#243247;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="570" width="220" height="150" as="geometry"/></mxCell>

        <mxCell id="uihead" value="1  |  CLIENTE WEB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="295" y="150" width="360" height="46" as="geometry"/></mxCell>
        <mxCell id="ui" value="&lt;b&gt;Angular SPA · localhost:4200&lt;/b&gt;&lt;br&gt;Aplicación de una sola página; componentes cargados por ruta.&lt;br&gt;&lt;br&gt;&lt;b&gt;Vistas principales&lt;/b&gt;&lt;br&gt;• Inicio, programas, simulador y preguntas frecuentes&lt;br&gt;• Registro e inicio de sesión&lt;br&gt;• Mi solicitud y documentación (estudiante)&lt;br&gt;• Evaluaciones (evaluador)&lt;br&gt;• Solicitudes, comités, usuarios y auditoría (coordinador)&lt;br&gt;&lt;br&gt;&lt;b&gt;Infraestructura frontend&lt;/b&gt;&lt;br&gt;• Angular Router + authGuard por rol&lt;br&gt;• HttpClient services para consumir API REST&lt;br&gt;• authInterceptor adjunta el token Bearer&lt;br&gt;• Theme service: modos claro y oscuro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;fontColor=#243247;fontSize=13;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="295" y="215" width="360" height="505" as="geometry"/></mxCell>
        <mxCell id="uibase" value="Base URL de desarrollo: http://localhost:5000/api&lt;br&gt;Los servicios Angular centralizan las llamadas HTTP por módulo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#93c5fd;fontColor=#1e3a5f;fontSize=12;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="295" y="735" width="360" height="80" as="geometry"/></mxCell>

        <mxCell id="apihead" value="2  |  API Y LÓGICA DE NEGOCIO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6d28d9;strokeColor=#6d28d9;fontColor=#ffffff;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="430" height="46" as="geometry"/></mxCell>
        <mxCell id="controllers" value="&lt;b&gt;ASP.NET Core Web API · .NET 8&lt;/b&gt;&lt;br&gt;&lt;b&gt;Controladores REST&lt;/b&gt;&lt;br&gt;Auth · Convocatorias · Solicitudes · Documentos&lt;br&gt;Asignaciones · Comités · Evaluaciones · Usuarios&lt;br&gt;Perfil · Reportes · Auditoría · Notificaciones&lt;br&gt;&lt;br&gt;Valida entrada, obtiene actor/rol del JWT y responde DTOs JSON.&lt;br&gt;Swagger disponible en Development." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#a78bfa;fontColor=#243247;fontSize=13;align=left;verticalAlign=middle;spacing=13;" vertex="1" parent="1"><mxGeometry x="700" y="215" width="430" height="190" as="geometry"/></mxCell>
        <mxCell id="services" value="&lt;b&gt;Servicios de aplicación / reglas de negocio&lt;/b&gt;&lt;br&gt;• AuthService: login, registro y emisión JWT&lt;br&gt;• ConvocatoriaService / ComiteService&lt;br&gt;• SolicitudService: ciclo de vida y decisiones&lt;br&gt;• DocumentoService: carga y consulta de archivos&lt;br&gt;• AsignacionService: reparto, revisión y evaluación&lt;br&gt;• GestionUsuariosService: perfiles por rol&lt;br&gt;• AuditoriaService / ReporteService / NotificacionService&lt;br&gt;&lt;br&gt;&lt;b&gt;Regla de aprobación&lt;/b&gt;&lt;br&gt;Hasta Q10,000: decisión de un coordinador.&lt;br&gt;Más de Q10,000: evaluación → preaprobación de un coordinador → aprobación final de otro coordinador. El evaluador solo revisa y califica." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#a78bfa;fontColor=#243247;fontSize=13;align=left;verticalAlign=top;spacing=13;" vertex="1" parent="1"><mxGeometry x="700" y="425" width="430" height="350" as="geometry"/></mxCell>
        <mxCell id="repos" value="&lt;b&gt;Acceso a datos&lt;/b&gt;&lt;br&gt;Repository pattern: repositorios para usuarios, solicitudes, convocatorias, documentos, comités y evaluaciones.&lt;br&gt;&lt;br&gt;Entity Framework Core 8 + BecaNetDbContext&lt;br&gt;Mapeo de entidades, relaciones, restricciones e índices; consultas LINQ y persistencia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;fontColor=#243247;fontSize=13;align=left;verticalAlign=middle;spacing=13;" vertex="1" parent="1"><mxGeometry x="700" y="795" width="430" height="130" as="geometry"/></mxCell>

        <mxCell id="datahead" value="3  |  PERSISTENCIA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=#0f766e;fontColor=#ffffff;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="350" height="46" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;SQL Server · BecaNetDB&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Identidad (TPT)&lt;/b&gt;&lt;br&gt;Usuario → Estudiante / CoordinadorBecas / EvaluadorComite&lt;br&gt;&lt;br&gt;&lt;b&gt;Proceso de beca&lt;/b&gt;&lt;br&gt;Convocatorias → Solicitudes&lt;br&gt;Documentos · Comites · ComiteMiembros&lt;br&gt;Evaluaciones · AprobacionSolicitud&lt;br&gt;&lt;br&gt;&lt;b&gt;Trazabilidad&lt;/b&gt;&lt;br&gt;RegistroAuditoria · NotificacionSolicitud&lt;br&gt;&lt;br&gt;Claves foráneas, índices únicos y restricción del tipo de aprobación. El esquema se prepara con BecaNet_Nuevos_Requisitos.sql al iniciar la API." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#34d399;fontColor=#243247;fontSize=13;align=left;verticalAlign=top;spacing=13;" vertex="1" parent="1"><mxGeometry x="1180" y="215" width="350" height="430" as="geometry"/></mxCell>
        <mxCell id="files" value="&lt;b&gt;Almacenamiento de documentos&lt;/b&gt;&lt;br&gt;Sistema de archivos local del backend:&lt;br&gt;BecaNet.Api/wwwroot/uploads&lt;br&gt;&lt;br&gt;La base conserva metadatos y la ruta/URL del documento; la API sirve los archivos estáticos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#34d399;fontColor=#243247;fontSize=13;align=left;verticalAlign=middle;spacing=13;" vertex="1" parent="1"><mxGeometry x="1180" y="665" width="350" height="170" as="geometry"/></mxCell>
        <mxCell id="dbinfo" value="Persistencia relacional; solicitudes conectan estudiante, convocatoria, asignación, evaluación, documentos y decisiones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#6ee7b7;fontColor=#1f453d;fontSize=12;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1180" y="855" width="350" height="70" as="geometry"/></mxCell>

        <mxCell id="securityhead" value="SEGURIDAD Y SERVICIOS TRANSVERSALES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#334155;fontColor=#ffffff;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1580" y="150" width="300" height="46" as="geometry"/></mxCell>
        <mxCell id="security" value="&lt;b&gt;Autenticación y autorización&lt;/b&gt;&lt;br&gt;JWT firmado; el frontend persiste la sesión y envía Bearer en cada petición.&lt;br&gt;[Authorize] por rol en endpoints protegidos; authGuard también controla las rutas del cliente.&lt;br&gt;&lt;br&gt;&lt;b&gt;Protección de credenciales&lt;/b&gt;&lt;br&gt;Contraseñas con hash (PasswordHasher); no se incluyen en auditoría.&lt;br&gt;&lt;br&gt;&lt;b&gt;CORS&lt;/b&gt;&lt;br&gt;Permite el origen local Angular :4200." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#243247;fontSize=13;align=left;verticalAlign=top;spacing=13;" vertex="1" parent="1"><mxGeometry x="1580" y="215" width="300" height="310" as="geometry"/></mxCell>
        <mxCell id="audit" value="&lt;b&gt;Auditoría y avisos&lt;/b&gt;&lt;br&gt;Auditoría identifica actor, rol, operación, entidad, cambio y hora UTC; el acceso al API está restringido a coordinadores.&lt;br&gt;&lt;br&gt;Observadores de solicitud generan avisos al estudiante por cambios de estado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fdba74;fontColor=#243247;fontSize=13;align=left;verticalAlign=middle;spacing=13;" vertex="1" parent="1"><mxGeometry x="1580" y="545" width="300" height="220" as="geometry"/></mxCell>
        <mxCell id="runtime" value="&lt;b&gt;Ejecución local&lt;/b&gt;&lt;br&gt;Angular dev server: :4200&lt;br&gt;ASP.NET Core API: :5000&lt;br&gt;SQL Server configurado por connection string&lt;br&gt;Swagger para explorar endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#243247;fontSize=12;align=left;verticalAlign=middle;spacing=13;" vertex="1" parent="1"><mxGeometry x="1580" y="785" width="300" height="140" as="geometry"/></mxCell>

        <mxCell id="flowhead" value="FLUJO PRINCIPAL DE UNA SOLICITUD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="30" y="970" width="1850" height="44" as="geometry"/></mxCell>
        <mxCell id="flow" value="1. Estudiante elige convocatoria, indica motivo y envía solicitud  →  2. Carga certificación/documentos  →  3. Coordinación distribuye entre evaluadores  →  4. Evaluador califica, escribe observaciones y marca «Revisado»  →  5. Coordinación decide según monto: ≤ Q10,000 una aprobación; &gt; Q10,000 preaprobación de un coordinador y aprobación final de otro  →  6. Estudiante consulta estado y notificaciones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#243247;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="1024" width="1850" height="76" as="geometry"/></mxCell>
        <mxCell id="legend" value="Leyenda: flechas sólidas = flujo principal entre capas; líneas punteadas = controles transversales de seguridad, auditoría y notificaciones. Diagrama basado en la implementación actual del proyecto." style="text;html=1;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35" y="1110" width="1800" height="30" as="geometry"/></mxCell>

        <mxCell id="e1" value="interfaz por rol" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3b82f6;fontColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="student" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="interfaz por rol" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7c3aed;fontColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="coordinator" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="interfaz por rol" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16a34a;fontColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="evaluator" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="HTTPS/HTTP REST · JSON · Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563eb;fontColor=#1e3a5f;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ui" target="controllers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="delegación" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7c3aed;fontColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="controllers" target="services"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="consultas y reglas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7c3aed;fontColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="services" target="repos"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="EF Core" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0f766e;fontColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="repos" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="guardar/servir archivos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0f766e;fontColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="services" target="files"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="protege endpoints" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeWidth=2;strokeColor=#64748b;fontColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="security" target="controllers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="auditoría y notificaciones" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeWidth=2;strokeColor=#f97316;fontColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="audit" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="módulos API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeWidth=2;strokeColor=#f97316;fontColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="services" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
